{
  "openapi": "3.0.0",
  "info": { "title": "enum-name-stability", "version": "1.0.0" },
  "paths": {
    "/tenants": {
      "get": {
        "operationId": "TenantController_list",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["SP", "RJ", "MG"] }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TenantAddress" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "TenantController_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MunicipalityBackOffice" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserRes" }
              }
            }
          }
        }
      }
    },
    "/users": {
      "post": {
        "operationId": "UserController_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserRes" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TenantAddress": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": { "type": "string", "enum": ["SP", "RJ", "MG"] }
        }
      },
      "MunicipalityBackOffice": {
        "type": "object",
        "required": ["state", "states"],
        "properties": {
          "state": { "type": "string", "enum": ["SP", "RJ", "MG"] },
          "states": {
            "type": "array",
            "items": { "type": "string", "enum": ["SP", "RJ", "MG"] }
          }
        }
      },
      "UserRes": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "enum": ["INTERNAL", "EXTERNAL"] }
        }
      },
      "UserDto": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "enum": ["OWNER", "GUEST"] }
        }
      }
    }
  }
}
